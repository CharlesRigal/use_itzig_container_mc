[Unit]
Description=MC Manager (Django) - gestion des serveurs Minecraft podman
After=network-online.target

[Service]
WorkingDirectory=%h/mcmanager
ExecStart=%h/mcmanager/.venv/bin/gunicorn mcmanager.wsgi -b 0.0.0.0:8000 -w 2 --threads 4 --timeout 600
Restart=on-failure
# Les serveurs Minecraft démarrés depuis l'interface vivent dans le cgroup du service :
# au redémarrage, seul gunicorn doit être arrêté, pas les conteneurs.
KillMode=process

[Install]
WantedBy=default.target
